{
    "folders": [
        { "name": "sarena-ebpf-programs", "path": "sarena-ebpf-programs" },
        { "name": "sarena-ebpf-test-programs", "path": "sarena-ebpf-test-programs" }
    ],
    "settings": {
        "rust-analyzer.cargo.target": "bpfel-unknown-none",
        "rust-analyzer.cargo.buildStd": ["core"],
        "rust-analyzer.check.overrideCommand": [
            "cargo",
            "check",
            "-p",
            "sarena-ebpf-programs",
            "-p",
            "sarena-ebpf-test-programs",
            "--profile",
            "ebpf",
            "--target",
            "bpfel-unknown-none",
            "-Z",
            "build-std=core",
            "--message-format=json"
        ],

        // Same rustfmt.toml applies here; keep auto-imports in its shape.
        "rust-analyzer.imports.granularity.group": "crate",
        "rust-analyzer.imports.granularity.enforce": true,
        "rust-analyzer.imports.prefix": "crate",

        // Format on save via rust-analyzer/rustfmt.
        "[rust]": {
            "editor.defaultFormatter": "rust-lang.rust-analyzer",
            "editor.formatOnSave": true
        },
        "editor.rulers": [100],

        "files.watcherExclude": {
            "**/target/**": true,
            "**/target-ebpf/**": true
        }
    }
}
